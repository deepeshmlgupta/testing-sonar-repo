{4C12537C-DB47-4CA2-9A6F-A532DE2454B3},MTED_EDaM_Entity_Maps_To_Entity,24=&quot;Hydrocarbon Material&quot;

{66B264C2-77DF-4936-90F7-430A96048FC3},MTED_EDaM_Design_Status,5=Draft

</a:ExtendedAttributesText>
</o:Entity>
