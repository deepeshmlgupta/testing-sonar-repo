<a:Code>T685A_KAPPL</a:Code>
<a:CreationDate>1719815732</a:CreationDate>
<a:Creator>Biren.Shah2</a:Creator>
<a:ModificationDate>1719815732</a:ModificationDate>
<a:Modifier>Biren.Shah2</a:Modifier>
<a:Comment>Subdivides the usage of a condition (for example, pricing) for use in different application areas (for example, sales &amp; distribution or purchasing</a:Comment>
<a:DataType>A2</a:DataType>
<a:Length>2</a:Length>
