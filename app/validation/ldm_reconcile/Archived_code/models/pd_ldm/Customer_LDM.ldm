<o:EntityAttribute Id="o801">
<a:ObjectID>C260DF26-F8BA-47BA-A423-9FDA197B03A9</a:ObjectID>
<a:Name>Exploration_Production_Condition</a:Name>
<a:Code>T685A_OIU_EP</a:Code>
