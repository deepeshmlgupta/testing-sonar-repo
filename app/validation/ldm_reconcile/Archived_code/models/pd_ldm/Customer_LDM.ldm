<a:Creator>Biren.Shah2</a:Creator>
<a:ModificationDate>1719815732</a:ModificationDate>
<a:Modifier>Biren.Shah2</a:Modifier>
<a:Comment>Conditions for which this indicator has been set can only be maintained via the &#39;Promotion&#39; menu - not via the Purchasing menu</a:Comment>
<a:DataType>A1</a:DataType>
<a:Length>1</a:Length>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
