<a:Creator>Biren.Shah2</a:Creator>
<a:ModificationDate>1719815732</a:ModificationDate>
<a:Modifier>Biren.Shah2</a:Modifier>
<a:Comment>A condition that is relevant for variant configuration</a:Comment>
<a:DataType>A1</a:DataType>
<a:Length>1</a:Length>
<a:ExtendedAttributesText>{930ED224-E528-44BB-9634-E758B0B77368},Shell_Attribute_Properties,126={F1CC8296-4560-4EC5-9345-1B45E56FBDE2},SAP_Field_Name,5=KVARC
