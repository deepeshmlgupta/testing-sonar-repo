{47E6A3AE-AA47-425C-AA05-CF089FE2BD43},SAP_Table_Name,5=T685A

</a:ExtendedAttributesText>
</o:EntityAttribute>
<o:EntityAttribute Id="o797">
<a:ObjectID>049A11AD-8EE6-478C-9BE8-BC5DA9F4C8EC</a:ObjectID>
<a:Name>Item_Routine</a:Name>
<a:Code>T685A_OIITEM</a:Code>
<a:CreationDate>1719815732</a:CreationDate>
<a:Creator>Biren.Shah2</a:Creator>
<a:ModificationDate>1719815732</a:ModificationDate>
<a:Modifier>Biren.Shah2</a:Modifier>
<a:Comment>This routine defines the format of the item section of the second level pricing analysis. The routine is maintained using transaction O5F5. This field cannot be entered unless the calculation type defines the condition type as Formula and Average.</a:Comment>
<a:DataType>N3</a:DataType>
<a:Length>3</a:Length>
<a:ExtendedAttributesText>{930ED224-E528-44BB-9634-E758B0B77368},Shell_Attribute_Properties,127={F1CC8296-4560-4EC5-9345-1B45E56FBDE2},SAP_Field_Name,6=OIITEM
