{47E6A3AE-AA47-425C-AA05-CF089FE2BD43},SAP_Table_Name,5=T685A

</a:ExtendedAttributesText>
</o:EntityAttribute>
<o:EntityAttribute Id="o764">
<a:ObjectID>AF40F0A3-9E65-4952-8F1C-9D60CB842D2B</a:ObjectID>
<a:Name>Enter_Supplier_Delivery_Costs_Goods_Receipt_Document</a:Name>
