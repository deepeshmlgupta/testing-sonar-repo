<a:ObjectID>5AAB8FF0-8412-4995-950E-06407751E583</a:ObjectID>
<a:Name>Central_Block_Flag</a:Name>
<a:Code>BUT000_XBLCK</a:Code>
<a:CreationDate>1620131798</a:CreationDate>
<a:Creator>Shrishail.Hiremath</a:Creator>
<a:ModificationDate>1702549387</a:ModificationDate>
<a:Modifier>Marcel.Kraan</a:Modifier>
<a:Comment>If the business partner is blocked centrally, certain activities cannot be executed.</a:Comment>
