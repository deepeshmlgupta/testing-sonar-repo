<o:EntityAttribute Id="o727">
<a:ObjectID>80C49DF3-CBC2-4AC6-8E58-105FA70E4942</a:ObjectID>
<a:Name>Condition_Type</a:Name>
<a:Code>T685A_KSCHL</a:Code>
<a:CreationDate>1719815732</a:CreationDate>
<a:Creator>Biren.Shah2</a:Creator>
<a:ModificationDate>1719815732</a:ModificationDate>
<a:Modifier>Biren.Shah2</a:Modifier>
<a:Comment>The condition type indicates, for example, whether, during pricing, the system applies a price, a discount, a surcharge, or other pricing elements, such as freight costs and sales taxes. For each of these pricing elements, there is a condition type defined in the system</a:Comment>
<a:DataType>A4</a:DataType>
<a:Length>4</a:Length>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:ExtendedAttributesText>{930ED224-E528-44BB-9634-E758B0B77368},Shell_Attribute_Properties,126={F1CC8296-4560-4EC5-9345-1B45E56FBDE2},SAP_Field_Name,5=KSCHL
{47E6A3AE-AA47-425C-AA05-CF089FE2BD43},SAP_Table_Name,5=T685A

</a:ExtendedAttributesText>
