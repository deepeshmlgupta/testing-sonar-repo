<a:ObjectID>87163BAF-27AC-4B5A-8603-6A12C72259C5</a:ObjectID>
<a:Name>Quantity_Conversion</a:Name>
<a:Code>T685A_KMENG</a:Code>
<a:CreationDate>1719815732</a:CreationDate>
<a:Creator>Biren.Shah2</a:Creator>
<a:ModificationDate>1719815732</a:ModificationDate>
<a:Modifier>Biren.Shah2</a:Modifier>
<a:Comment>This field controls the quantity conversion during determination of the condition basis.</a:Comment>
<a:DataType>A1</a:DataType>
<a:Length>1</a:Length>
<a:ExtendedAttributesText>{930ED224-E528-44BB-9634-E758B0B77368},Shell_Attribute_Properties,126={F1CC8296-4560-4EC5-9345-1B45E56FBDE2},SAP_Field_Name,5=KMENG
