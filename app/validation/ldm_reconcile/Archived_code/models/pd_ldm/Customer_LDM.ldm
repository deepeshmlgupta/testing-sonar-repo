<o:EntityAttribute Id="o790">
<a:ObjectID>F30D8E88-E103-4E1E-A173-4D844B50923D</a:ObjectID>
<a:Name>Usage_Condition_Type</a:Name>
<a:Code>T685A_CCS_USAGE</a:Code>
<a:CreationDate>1719815732</a:CreationDate>
<a:Creator>Biren.Shah2</a:Creator>
<a:ModificationDate>1719815732</a:ModificationDate>
<a:Modifier>Biren.Shah2</a:Modifier>
<a:Comment>The parameter controls that certain checks and functions can be restricted to the relevant condition type.</a:Comment>
<a:DataType>A1</a:DataType>
<a:Length>1</a:Length>
<a:ExtendedAttributesText>{930ED224-E528-44BB-9634-E758B0B77368},Shell_Attribute_Properties,130={F1CC8296-4560-4EC5-9345-1B45E56FBDE2},SAP_Field_Name,9=CCS_USAGE
