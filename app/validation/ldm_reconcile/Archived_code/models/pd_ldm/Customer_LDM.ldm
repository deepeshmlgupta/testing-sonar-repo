</a:ExtendedAttributesText>
</o:EntityAttribute>
<o:EntityAttribute Id="o721">
<a:ObjectID>1767F923-33C3-4174-A5BA-9C57B0AE5FDF</a:ObjectID>
<a:Name>Dunning_Area</a:Name>
<a:Code>T047M_MABER</a:Code>
<a:CreationDate>1718371148</a:CreationDate>
<a:Creator>Biren.Shah2</a:Creator>
<a:ModificationDate>1724650482</a:ModificationDate>
<a:Modifier>Biren.Shah2</a:Modifier>
<a:Comment>You use dunning areas if several organizational units are responsible for carrying out dunning within a company code. These organizational units are represented by dunning areas in the SAP System. Note. You only need dunning areas if you do not process dunning at company code level.</a:Comment>
<a:DataType>A2</a:DataType>
<a:Length>2</a:Length>
<a:LogicalAttribute.Mandatory>1</a:LogicalAttribute.Mandatory>
<a:ExtendedAttributesText>{930ED224-E528-44BB-9634-E758B0B77368},Shell_Attribute_Properties,126={F1CC8296-4560-4EC5-9345-1B45E56FBDE2},SAP_Field_Name,5=MABER
